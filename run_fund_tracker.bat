@echo off
title 基金跟踪系统启动器

:: ========================================================
:: 1. 切换工作目录到当前 bat 文件所在位置
::    (确保程序能找到 fund_main.py 和 funds.txt)
:: ========================================================
cd /d "%~dp0"

:: ========================================================
:: 2. 激活 Conda 环境 (Explore)
::    根据你之前的报错路径，你的 Miniforge 安装在下方位置
::    如果路径不对，请修改引号内的路径
:: ========================================================
call "C:\Users\138721\AppData\Local\miniforge3\Scripts\activate.bat" Explore

:: ========================================================
:: 3. 启动 GUI 程序
:: ========================================================
echo 正在启动基金跟踪系统...
python fund_gui.py

:: ========================================================
:: 4. 错误捕获
::    如果程序异常退出，暂停窗口让你看报错信息
:: ========================================================
if %errorlevel% neq 0 (
    echo.
    echo [出错啦] 程序异常退出，请检查上方报错信息。
    pause
)