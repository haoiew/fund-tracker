# ============================================
# 生产环境配置 - 安卓部署前必须修改
# ============================================

# API基础URL - 必须改为实际服务器地址
# 本地开发: http://localhost:8001/api/v1
# Oracle Cloud: http://<你的Oracle-IP>:8000/api/v1
# 示例: VITE_API_BASE_URL=http://132.145.123.45:8000/api/v1
VITE_API_BASE_URL=http://localhost:8001/api/v1

# 应用标题
VITE_APP_TITLE=基金跟踪器

# 应用版本
VITE_APP_VERSION=2.0.0

# ============================================
# 部署检查清单：
# [ ] 1. 已注册 Oracle Cloud 账号
# [ ] 2. 已创建 VM 实例并记录公共 IP
# [ ] 3. 已配置安全组开放 8000 端口
# [ ] 4. 已在服务器上部署后端服务
# [ ] 5. 已将上方 VITE_API_BASE_URL 改为服务器 IP
# [ ] 6. 使用 HBuilderX 打包 APK
# ============================================
