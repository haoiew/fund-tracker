{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "基金跟踪器",
  "version": "3.0.0",
  "identifier": "com.fundtracker.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run tauri:dev:web",
    "beforeBuildCommand": "npm run tauri:build:web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "基金跟踪器",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24,
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
